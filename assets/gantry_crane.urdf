<?xml version="1.0" ?>
<robot name="gantry_crane">
  <!-- Desktop gantry: load at table center [0.55, 0, 0].
       trolley_x=0, gantry_y=0 places the hook over the table origin.
       Girder / cable attachment is at z = 1.32 m.
       Rails extend to cover bogies throughout the gantry travel.
       Hoist prismatic along -Z so positive l lowers the hook. -->

  <material name="steel"><color rgba="0.56 0.60 0.64 1"/></material>
  <material name="wheel_tread"><color rgba="0.12 0.14 0.16 1"/></material>
  <material name="wheel_flange"><color rgba="0.30 0.33 0.36 1"/></material>
  <material name="bolt"><color rgba="0.72 0.75 0.78 1"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="-0.82 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 1.50 0.04"/>
      </geometry>
      <material name="rail">
        <color rgba="0.18 0.18 0.20 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.82 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 1.50 0.04"/>
      </geometry>
      <material name="rail">
        <color rgba="0.18 0.18 0.20 1"/>
      </material>
    </visual>
  </link>

