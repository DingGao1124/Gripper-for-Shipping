  <joint name="trolley_x" type="prismatic">
    <parent link="gantry_link"/>
    <child link="trolley_link"/>
    <origin xyz="0 0 1.32" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.40" upper="0.40" effort="200" velocity="1.0"/>
    <dynamics damping="4.0" friction="0.0"/>
  </joint>

  <link name="sway_x_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="sway_x" type="revolute">
    <parent link="trolley_link"/>
    <child link="sway_x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.4" upper="1.4" effort="20" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="sway_y_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="sway_y" type="revolute">
    <parent link="sway_x_link"/>
    <child link="sway_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.4" upper="1.4" effort="20" velocity="10"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="hook_link">
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="2e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="hook">
        <color rgba="0.78 0.16 0.12 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.04"/>
      </geometry>
      <material name="hook">
        <color rgba="0.78 0.16 0.12 1"/>
      </material>
    </visual>
  </link>

  <joint name="hoist" type="prismatic">
    <parent link="sway_y_link"/>
    <child link="hook_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.05" upper="0.72" effort="80" velocity="0.8"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>
</robot>
