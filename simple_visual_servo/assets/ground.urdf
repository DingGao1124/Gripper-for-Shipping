<?xml version="1.0"?>
<robot name="ground">
  <link name="floor">
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="12 12 0.1"/></geometry>
      <material name="grey"><color rgba="0.65 0.65 0.65 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="12 12 0.1"/></geometry>
    </collision>
  </link>
</robot>
